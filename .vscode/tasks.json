{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start SmartBase frontend",
            "type": "shell",
            "command": "npm.cmd",
            "args": [
                "run",
                "dev"
            ],
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": ".*http://localhost:5180/.*"
                }
            }
        }
    ]
}
